{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Gradle Build (Java 8)",
      "type": "shell",
      "command": "./gradlew build",
      "options": {
        "env": {
          "JAVA_HOME": "/usr/lib/jvm/java-8-openjdk",
          "PATH": "/usr/lib/jvm/java-8-openjdk/bin:${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
